DEBUG=true
SECRET_KEY=test-only-secret
MIGRATE_DATABASE_URL=postgresql://postgres:postgres_dev_only@localhost:5436/campus_manager_django_test
APP_DB_PASSWORD=changeme_app
DATABASE_URL=postgresql://campus_manager_django_app:changeme_app@localhost:5436/campus_manager_django_test
COOKIE_SECRET=test-only-secret
SESSION_TTL_HOURS=8
PORT=3002
ALLOWED_ORIGIN=http://localhost:3000
NOTIFICATION_SENDER=console

# [V8.8] Limites de débit désactivées en pratique pour la suite de tests :
# elle enchaîne des dizaines de connexions depuis 127.0.0.1 et épuiserait
# un quota réaliste, faisant échouer des tests qui n'ont rien à voir avec
# la sécurité. Les tests qui vérifient LA LIMITE elle-même
# (tests/test_securite.py) imposent leurs propres valeurs basses via
# override_settings — c'est là, et seulement là, que le quota est éprouvé.
THROTTLE_CONNEXION_IP=10000/min
THROTTLE_CONNEXION_COMPTE=10000/min
THROTTLE_ACTIVATION=10000/min
THROTTLE_MOT_DE_PASSE=10000/min
