DEBUG=true
SECRET_KEY=change-me-in-production

# Superutilisateur (migrations, DDL) — jamais utilisé par l'app en marche.
MIGRATE_DATABASE_URL=postgresql://postgres:postgres_dev_only@localhost:5436/campus_manager_django
# Rôle restreint (campus_manager_django_app, créé par la migration
# audit.0002_audit_and_journal_grants) — celui que l'app utilise réellement.
APP_DB_PASSWORD=changeme_app
DATABASE_URL=postgresql://campus_manager_django_app:changeme_app@localhost:5436/campus_manager_django

COOKIE_SECRET=dev-only-not-for-production
SESSION_TTL_HOURS=8
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
NOTIFICATION_SENDER=console
