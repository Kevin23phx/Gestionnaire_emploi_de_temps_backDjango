DEBUG=true
SECRET_KEY=change-me-in-production

# Superutilisateur (migrations, DDL) — jamais utilisé par l'app en marche.
MIGRATE_DATABASE_URL=postgresql://postgres:postgres_dev_only@localhost:5436/campus_manager_django
# Rôle restreint (campus_manager_django_app, créé par la migration
# audit.0002_audit_and_journal_grants) — celui que l'app utilise réellement.
APP_DB_PASSWORD=changeme_app
DATABASE_URL=postgresql://campus_manager_django_app:changeme_app@localhost:5436/campus_manager_django

COOKIE_SECRET=dev-only-not-for-production
SESSION_TTL_HOURS=8
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
# [V3] Alertes Web Push (FR-PUB-08). "console" = journalisation seule, tout
# le reste du système fonctionne sans clés. Générer une paire :
# `venv/bin/vapid --gen`.
PUSH_SENDER=console
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:scolarite@ujkz.bf

# ---------------------------------------------------------------------------
# [V8.8] Sécurité — OBLIGATOIRES dès que DEBUG=false
# ---------------------------------------------------------------------------
# Le serveur REFUSE de démarrer si SECRET_KEY vaut encore une valeur
# d'exemple, ou si ALLOWED_HOSTS est vide. Un oubli au déploiement doit
# arrêter la mise en ligne, pas la réussir en silence avec un système ouvert.
# Domaines servis, séparés par des virgules (jamais "*" en production).
ALLOWED_HOSTS=

# Limitation des tentatives d'authentification (OWASP A07). Réglables pour
# absorber un incident sans redéploiement — jamais pour les désactiver.
# Par IP, puis par compte visé : la seconde arrête l'attaque distribuée.
THROTTLE_CONNEXION_IP=10/min
THROTTLE_CONNEXION_COMPTE=5/min
THROTTLE_ACTIVATION=5/min
THROTTLE_MOT_DE_PASSE=5/min

# HSTS et redirection HTTPS — actifs uniquement quand DEBUG=false.
HSTS_SECONDS=31536000
SSL_REDIRECT=true
